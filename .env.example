# Copy to .env.local and fill in. All values are public identifiers, not secrets.

# Base URL of the Hydrolink API. Include the version prefix the backend expects
# (the app appends only the resource path, e.g. /devices/{key}/command).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.19:8080/v1

# AWS Cognito
EXPO_PUBLIC_AWS_USER_POOL_ID=
EXPO_PUBLIC_AWS_USER_POOL_CLIENT_ID=
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=
EXPO_PUBLIC_AWS_REGION=eu-west-1
EXPO_PUBLIC_AWS_IOT_ENDPOINT=
